# Copy to .env.local (or run `neon deploy`, which writes it for you)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Neon "test" branch (tests wipe tables, so NEVER use the production branch here)
TEST_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
